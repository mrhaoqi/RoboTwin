<?xml version="1.0" encoding="UTF-8"?>
<!--RM65-B 单臂 + 精简 4C2 夹爪的语义描述。
    配套 URDF: urdf/rm65b.urdf (12 link / 11 joint)。
    生成自 scratchpad/make_srdf.py，规则见任务 08-05-rm65b-register-mplib 的 design.md。-->
<robot name="rm65b">
    <group name="rm65b_arm">
        <chain base_link="arm_base_link1" tip_link="r_link6"/>
    </group>
    <group name="gripper">
        <joint name="4C2_Joint1"/>
    </group>
    <group_state name="home" group="rm65b_arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0"/>
        <joint name="joint3" value="0"/>
        <joint name="joint4" value="0"/>
        <joint name="joint5" value="0"/>
        <joint name="joint6" value="0"/>
    </group_state>
    <end_effector name="gripper_ee" parent_link="r_link6" group="gripper"/>

    <disable_collisions link1="4C2_Link1" link2="4C2_Link4" reason="Never"/>
    <disable_collisions link1="4C2_Link1" link2="4C2_Link5" reason="Never"/>
    <disable_collisions link1="4C2_Link1" link2="4C2_Link6" reason="Never"/>
    <disable_collisions link1="4C2_Link1" link2="4C2_baselink" reason="Never"/>
    <disable_collisions link1="4C2_Link1" link2="r_link5" reason="Never"/>
    <disable_collisions link1="4C2_Link1" link2="r_link6" reason="Never"/>
    <disable_collisions link1="4C2_Link4" link2="4C2_Link5" reason="Never"/>
    <disable_collisions link1="4C2_Link4" link2="4C2_Link6" reason="Never"/>
    <disable_collisions link1="4C2_Link4" link2="4C2_baselink" reason="Never"/>
    <disable_collisions link1="4C2_Link4" link2="r_link5" reason="Never"/>
    <disable_collisions link1="4C2_Link4" link2="r_link6" reason="Never"/>
    <disable_collisions link1="4C2_Link5" link2="4C2_Link6" reason="Never"/>
    <disable_collisions link1="4C2_Link5" link2="4C2_baselink" reason="Never"/>
    <disable_collisions link1="4C2_Link5" link2="r_link5" reason="Never"/>
    <disable_collisions link1="4C2_Link5" link2="r_link6" reason="Never"/>
    <disable_collisions link1="4C2_Link6" link2="4C2_baselink" reason="Never"/>
    <disable_collisions link1="4C2_Link6" link2="r_link5" reason="Never"/>
    <disable_collisions link1="4C2_Link6" link2="r_link6" reason="Never"/>
    <disable_collisions link1="4C2_baselink" link2="r_link5" reason="Never"/>
    <disable_collisions link1="4C2_baselink" link2="r_link6" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link1" link2="r_link1" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link1" link2="r_link2" reason="Never"/>
    <disable_collisions link1="r_link1" link2="r_link2" reason="Adjacent"/>
    <disable_collisions link1="r_link1" link2="r_link3" reason="Never"/>
    <disable_collisions link1="r_link2" link2="r_link3" reason="Adjacent"/>
    <disable_collisions link1="r_link2" link2="r_link4" reason="Never"/>
    <disable_collisions link1="r_link3" link2="r_link4" reason="Adjacent"/>
    <disable_collisions link1="r_link3" link2="r_link5" reason="Never"/>
    <disable_collisions link1="r_link4" link2="r_link5" reason="Adjacent"/>
    <disable_collisions link1="r_link4" link2="r_link6" reason="Never"/>
    <disable_collisions link1="r_link5" link2="r_link6" reason="Adjacent"/>
</robot>
